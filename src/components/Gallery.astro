---
import { studio } from '../consts';
import { hasPhoto, photoSrc } from '../lib/photos';

/**
 * Trabalhos reais do estúdio.
 * Enquanto o arquivo não estiver em public/images/, aparece o placeholder.
 * Basta salvar a foto com o nome indicado para ela entrar no ar.
 */
const photos = [
  {
    file: 'retrato-01.jpg',
    label: 'Retrato executivo',
    alt: 'Executiva de blazer preto sorrindo enquanto usa um tablet, fundo cinza claro',
  },
  {
    file: 'retrato-02.jpg',
    label: 'Branding pessoal',
    alt: 'Retrato corporativo de mulher de colete xadrez com os braços cruzados',
  },
  {
    file: 'retrato-03.jpg',
    label: 'Ensaio em estúdio',
    alt: 'Mulher de blazer branco sentada em um banco, fundo claro',
  },
  {
    file: 'retrato-04.jpg',
    label: 'Editorial',
    alt: 'Retrato editorial em fundo escuro com luz azulada',
  },
  {
    file: 'retrato-05.jpg',
    label: 'Headshot',
    alt: 'Executiva de blazer branco segurando um tablet, fundo escuro',
  },
  {
    file: 'retrato-06.jpg',
    label: 'Direção de pose',
    alt: 'Retrato corporativo de mulher sorrindo com um cartão de visita em primeiro plano',
  },
];

const missing = photos.filter((photo) => !hasPhoto(photo.file)).length;
---

<section class="section" id="galeria">
  <div class="wrap">
    <div class="gallery__head">
      <div>
        <p class="eyebrow">Galeria</p>
        <h2 class="section__title">Um recorte do trabalho</h2>
      </div>
      <a
        class="gallery__ig"
        href={studio.instagramUrl}
        target="_blank"
        rel="noopener"
      >
        <span>Ver mais no Instagram</span>
        <strong>{studio.instagramHandle}</strong>
      </a>
    </div>

    <div class="gallery">
      {photos.map((photo) => (
        <figure class="shot">
          <div class="shot__media">
            {hasPhoto(photo.file) ? (
              <img
                src={photoSrc(photo.file)}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                width="900"
                height="1200"
              />
            ) : (
              <span class="shot__ph" aria-hidden="true">◦</span>
            )}
          </div>
          <figcaption>
            <span>{photo.label}</span>
            <span aria-hidden="true">↗</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {missing > 0 && (
      <p class="gallery__note">
        {missing === photos.length
          ? 'As imagens desta grelha são temporárias e serão substituídas pelos ensaios reais do estúdio.'
          : `Faltam ${missing} ${missing === 1 ? 'foto' : 'fotos'} de trabalho em public/images/.`}
      </p>
    )}
  </div>
</section>

<style>
  .gallery__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .gallery__ig {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }

  .gallery__ig:hover {
    border-color: var(--gold);
  }

  .gallery__ig span {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .gallery__ig strong {
    color: var(--gold);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.6vw, 18px);
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    align-items: start;
  }

  .shot {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* deslocamento leve nas colunas do meio para um ar editorial */
  .shot:nth-child(3n + 2) {
    margin-top: clamp(0, 3vw, 2.6rem);
  }

  .shot__media {
    position: relative;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 25% 0%, rgba(217, 189, 139, 0.13), transparent 62%),
      repeating-linear-gradient(45deg, rgba(245, 242, 236, 0.04) 0 1px, transparent 1px 10px),
      var(--surface);
    transition: border-color 0.2s ease, transform 0.25s ease;
  }

  .shot__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    transition: transform 0.45s ease;
  }

  .shot:hover .shot__media {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  .shot:hover .shot__media img {
    transform: scale(1.03);
  }

  .shot__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(217, 189, 139, 0.65);
    font-size: 1.4rem;
  }

  .shot figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gallery__note {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 860px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shot:nth-child(3n + 2) {
      margin-top: 0;
    }

    .shot:nth-child(2n) {
      margin-top: clamp(0, 5vw, 2rem);
    }
  }

  @media (max-width: 520px) {
    .gallery {
      gap: 10px;
    }

    .shot figcaption {
      font-size: 0.66rem;
    }
  }
</style>
