---
import { studio } from '../consts';

/**
 * Placeholders até as fotos reais chegarem.
 * Para trocar: substitua a <div class="shot__media"> por
 *   <img src="/images/headshot-01.jpg" alt="Headshot corporativo em fundo neutro" loading="lazy" />
 */
const photos = [
  { n: '01', label: 'Headshot', size: 'tall' },
  { n: '02', label: 'Retrato executivo', size: 'wide' },
  { n: '03', label: 'Branding pessoal', size: 'tall' },
  { n: '04', label: 'Equipa', size: 'square' },
  { n: '05', label: 'Editorial', size: 'tall' },
  { n: '06', label: 'Bastidores', size: 'square' },
  { n: '07', label: 'Ensaio', size: 'wide' },
  { n: '08', label: 'Detalhe', size: 'tall' },
];
---

<section class="section" id="galeria">
  <div class="wrap">
    <div class="gallery__head">
      <div>
        <p class="eyebrow">Galeria</p>
        <h2 class="section__title">Um recorte do trabalho</h2>
      </div>
      <a
        class="gallery__ig"
        href={studio.instagramUrl}
        target="_blank"
        rel="noopener"
      >
        <span>Ver mais no Instagram</span>
        <strong>{studio.instagramHandle}</strong>
      </a>
    </div>

    <div class="gallery">
      {photos.map((photo) => (
        <figure class={`shot shot--${photo.size}`}>
          <div class="shot__media">
            <span>{photo.n}</span>
          </div>
          <figcaption>
            <span>{photo.label}</span>
            <span aria-hidden="true">↗</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="gallery__note">
      As imagens desta grelha são temporárias e serão substituídas pelos ensaios reais do
      estúdio.
    </p>
  </div>
</section>

<style>
  .gallery__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .gallery__ig {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }

  .gallery__ig:hover {
    border-color: var(--gold);
  }

  .gallery__ig span {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .gallery__ig strong {
    color: var(--gold);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 190px;
    gap: 12px;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .shot {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    grid-row: span 2;
  }

  .shot--wide {
    grid-column: span 2;
    grid-row: span 1;
  }

  .shot--square {
    grid-column: span 1;
    grid-row: span 1;
  }

  .shot__media {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 25% 0%, rgba(217, 189, 139, 0.13), transparent 62%),
      repeating-linear-gradient(45deg, rgba(245, 242, 236, 0.04) 0 1px, transparent 1px 10px),
      var(--surface);
    transition: border-color 0.2s ease, transform 0.25s ease;
  }

  .shot:hover .shot__media {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  .shot__media span {
    color: rgba(217, 189, 139, 0.75);
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.1em;
  }

  .shot figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gallery__note {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 160px;
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 140px;
      gap: 8px;
    }

    .shot--wide {
      grid-column: span 2;
    }
  }
</style>
