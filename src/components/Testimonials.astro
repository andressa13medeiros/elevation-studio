---
/**
 * Avaliações reais publicadas no Google (transcritas dos prints enviados
 * pelo estúdio em novembro de 2026). Ajustar apenas se a cliente autorizar.
 */
const testimonials = [
  {
    quote:
      'Muito profissional, simpática e dinâmica. Desde o primeiro momento faz-te sentir à vontade e ajuda-te a posar de forma natural, o que se agradece imenso. O resultado superou as minhas expectativas: as fotos ficaram espetaculares. Sem dúvida, uma experiência incrível. Mais do que recomendada!',
    name: 'Dani Vieira',
    detail: 'Avaliação no Google',
  },
  {
    quote:
      'Super recomendo! Andressa foi super atenciosa, me ajudou com as poses e postura, indicando referências que me ajudaram a comunicar minha marca pessoal. Com certeza já vou programar a próxima sessão.',
    name: 'Julie Santos',
    detail: 'Avaliação no Google',
  },
  {
    quote:
      'Tive uma experiência excelente, a Andressa é maravilhosa no que faz! ✨✨✨',
    name: 'Tatiane Fiel',
    detail: 'Avaliação no Google',
  },
  {
    quote:
      'Amei o resultado das fotos, trabalho incrível da Andressa, além do atendimento. Ela é uma querida.',
    name: 'Sarah Cardoso',
    detail: 'Avaliação no Google',
  },
];
---

<section class="section" id="depoimentos">
  <div class="wrap">
    <p class="eyebrow">Depoimentos</p>
    <h2 class="section__title">O que dizem depois da sessão</h2>

    <ul class="quotes">
      {testimonials.map((item) => (
        <li class="quote">
          <span class="quote__mark" aria-hidden="true">“</span>
          <span class="quote__stars" role="img" aria-label="5 de 5 estrelas">
            <span aria-hidden="true">★★★★★</span>
          </span>
          <blockquote class="quote__text">{item.quote}</blockquote>
          <footer class="quote__foot">
            <span class="quote__avatar" aria-hidden="true"></span>
            <span>
              <strong>{item.name}</strong>
              <small>{item.detail}</small>
            </span>
          </footer>
        </li>
      ))}
    </ul>

    <p class="quotes__note">
      Avaliações reais de clientes, publicadas no perfil do estúdio no Google.
    </p>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.6vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(170deg, var(--surface-2), var(--surface));
  }

  .quote__mark {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 0.5;
  }

  .quote__stars {
    color: var(--gold);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
  }

  .quote__text {
    flex: 1;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .quote__foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .quote__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: radial-gradient(circle at 35% 30%, rgba(217, 189, 139, 0.35), transparent 70%),
      var(--surface);
    flex: none;
  }

  .quote__foot span {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .quote__foot strong {
    font-size: 0.86rem;
    font-weight: 600;
  }

  .quote__foot small {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .quotes__note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 900px) {
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
