---
import { studio } from '../consts';
---

<a
  class="wa-float"
  href={studio.whatsappUrl}
  target="_blank"
  rel="noopener"
  aria-label={`Falar no WhatsApp — ${studio.whatsappLabel}`}
  data-whatsapp
  data-cta="WHATSAPP FLUTUANTE"
>
  <span class="wa-float__label" aria-hidden="true">Fale conosco</span>
  <span class="wa-float__icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="26" height="26" focusable="false">
      <path
        fill="currentColor"
        d="M16.04 3.2c-7.06 0-12.8 5.73-12.8 12.79 0 2.25.59 4.45 1.71 6.39L3.2 28.8l6.6-1.72a12.77 12.77 0 0 0 6.23 1.59h.01c7.05 0 12.79-5.74 12.79-12.8a12.7 12.7 0 0 0-3.74-9.04 12.68 12.68 0 0 0-9.05-3.63Zm0 23.32h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.01 1.05 1.07-3.91-.25-.4a10.57 10.57 0 0 1-1.62-5.65c0-5.87 4.78-10.64 10.65-10.64a10.55 10.55 0 0 1 7.52 3.12 10.55 10.55 0 0 1 3.11 7.53c0 5.87-4.78 10.61-10.67 10.61Zm5.85-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.71.16-.21.32-.82 1.04-1.01 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.58a9.6 9.6 0 0 1-1.78-2.21c-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.35-.26-.63-.52-.54-.71-.55h-.61c-.21 0-.55.08-.84.4-.29.32-1.1 1.08-1.1 2.63s1.13 3.05 1.29 3.26c.16.21 2.22 3.39 5.38 4.75.75.32 1.34.52 1.8.66.76.24 1.44.21 1.99.13.61-.09 1.89-.77 2.16-1.52.27-.74.27-1.38.19-1.51-.08-.13-.29-.21-.61-.37Z"
      />
    </svg>
  </span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.72rem 1.05rem;
    border-radius: 999px;
    background: var(--wa);
    color: #04240f;
    font-size: 0.88rem;
    font-weight: 700;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .wa-float:hover {
    transform: translateY(-3px);
    background: #35e078;
  }

  .wa-float__icon {
    display: grid;
    place-items: center;
  }

  @media (max-width: 560px) {
    .wa-float {
      padding: 0.85rem;
      gap: 0;
    }

    .wa-float__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      animation: none;
    }
  }
</style>
